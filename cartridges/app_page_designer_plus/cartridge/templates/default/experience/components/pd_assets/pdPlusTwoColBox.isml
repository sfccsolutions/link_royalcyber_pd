<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
        assets.addCss('/css/experience/components/pd_assets/pdPlusTwoColBox.css');
</isscript>

<iscomment> Column Box Item </iscomment>
<div class="box-col-item d-flex align-items-${pdict.textAlignmentVertical} justify-content-${pdict.textAlignmentHorizontal}" <isif condition="${pdict.BGImageProperties}"><isprint value="${pdict.BGImageProperties}" encoding="off" /></isif>>
    <div class="bgcolor-overlay" style= "background-color:${pdict.bgOverlay}"></div>
    <div class="text-editor ${pdict.AnimationLax} ${pdict.textShadow}" <isif condition="${pdict.editorProps}"><isprint value="${pdict.editorProps}" encoding="off" /></isif>">
        <h2 <isprint value="${pdict.headingTextProps}" encoding="off" />><isprint value="${pdict.headingText}" encoding="off"/></h2>
        <isprint value="${pdict.richText}" encoding="off"/>
    </div>
</div>
