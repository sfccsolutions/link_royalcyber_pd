<div class="expanding-thumbnail">
    <div class="expanding-box">
        <div class="expanding-content">
            <div class="thumbnail-image">
                <a href="${pdict.product.url}">
                    <isif condition="${pdict.product.image == null}">
                        <picture class="bnr-img image-container">
                            <img src="${URLUtils.staticURL('/images/nulled-image.jpg')}" alt="${pdict.product.name}"
                                title="${pdict.product.name}" />
                        </picture>
                    <iselse/>
                        <picture class="bnr-img image-container">
                            <img src="${pdict.product.image}" alt="${pdict.product.name}"
                                title="${pdict.product.name}" />
                        </picture>
                    </isif>
                </a>
            </div>

            <div class="product-details">
                <h2>${pdict.product.name}</h2>
                <h3>${pdict.product.category}</h3>

                <p>${pdict.product.price}</p>

                <isif condition="${pdict.product.stock !== 'N/A'}">
                    <p class="quantity">Available Quantity: ${pdict.product.stock}</p>
                </isif>

                <span class="availability ${pdict.product.availability == 'In Stock' ? 'in-stock' : 'out-of-stock'}">
                    ${pdict.product.availability == 'In Stock' ? 'In Stock' : 'Out Of Stock'}
                </span>
            </div>
        </div>

        <div class="add-button openBtn">
            <svg viewBox="0 0 24 24">
                <path d="M12 4v16M4 12h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none">
                </path>
            </svg>
        </div>
    </div>
</div>

<div class="overlay-modal">
    <div class="overlay-banner"></div>

    <div class="modal-banner">
        <div class="modal-header">
            <h4>At a glance</h4>
            <a href="${'#'}">x</a>
        </div>
        <div class="modal-slider-outer">
            <div class="badges"><span class="badge badge-new"></span></div>
            <div class="modal-slider-content">

            </div>
        </div>
        <div class="">
            <h2>Middlebury Large Pendant</h2>
            <h3>Arteriors Home</h3>

            <div class="price">2,110 USD</div>

            <div class="rating">
                <span>
                    <span></span>
                </span>
                <div class="">
                    4.5 (120 Reviews)
                </div>
            </div>

            <div class="sku-id">
                <span>Bellacor ID: BC7542255</span>
                <span>MFR SKU: 339091ML</span>
            </div>

            <div class="">
                <div class="custom-dropdown">
                    <button id="dropdown-button" class="select-button" role="combobox" aria-label="select button"
                        aria-haspopup="listbox" aria-expanded="false" aria-controls="select-dropdown">
                        <span class="selected-value">Finish: <i class="swatch swatch-beige"></i> Swatches</span>
                        <span class="arrow"></span>
                    </button>
                    <ul class="select-dropdown hidden" role="listbox" id="select-dropdown" aria-labelledby="dropdown-button">
                        <li role="option">Finish: <i class="swatch swatch-beige"></i> <span>Natural</span></li>
                        <li role="option">Finish: <i class="swatch swatch-green"></i> <span>Lights</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>