<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/pdPlusSlick.js');
    assets.addCss('/css/slick.css');
</isscript>

<div class="${pdict.customClassName ? pdict.customClassName : ''}">
    <div id="${pdict.id}" class="photo-slick-slider ${pdict.slickScrollClass} ${pdict.slickArrowAdjustClass}" data-config="${pdict.slickConfiguration}">
        <isprint value="${pdict.regions.slides.render()}" encoding="off" />
    </div>
</div>
