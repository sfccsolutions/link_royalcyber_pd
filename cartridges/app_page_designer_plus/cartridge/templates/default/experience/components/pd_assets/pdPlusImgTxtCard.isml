<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addCss('/css/experience/components/pd_assets/pdPlusImgTxtCard.css');
</isscript>

<div class="pdplus-card-img-txt" data-aos="${pdict.animationType}" data-aos-duration="${pdict.animationDuration}">
    <div class="pdplus-card-img">
        <img src="${pdict.cardImgFile}" alt="${pdict.cardImgAlt}" title="${pdict.cardImgAlt}" />
    </div>
    <div class="pdplus-card-txt ${pdict.cardTextColor === 'Black' ? 'text-black' : 'text-white'}">
        <div class="card-txt-inner"><isprint value="${pdict.cardRichText}" encoding="off"/></div>
    </div>
</div>

