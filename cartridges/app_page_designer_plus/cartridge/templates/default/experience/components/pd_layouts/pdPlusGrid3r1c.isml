<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addCss('/css/experience/components/commerceLayouts/layout.css');
    assets.addCss('/css/experience/components/pd_layouts/pdPlusGridLayout.css');
</isscript>

<div class="pdplus-component pdplus-3r-1c ${pdict.bgImageParallax !== null ? pdict.bgImageParallax : ''}" <isif condition="${pdict.BGImageProperties !== null}"><isprint value="${pdict.BGImageProperties}" encoding="off" /></isif>>
    <div class="bgcolor-overlay" ${pdict.bgOverlay}></div>

    <div class="pdplus-grid-wrapper">
        <div class="${pdict.isContainer}" style="max-width: ${pdict.maxWidth};">
            <div class="row align-items-${pdict.verticalAlignment} justify-content-${pdict.horizontalAlginment}">
                <isif condition="${pdict.removeGutter === true}">
                    <isprint value="${pdict.regions.column1.setClassName(" region col-12 col-sm-4 px-0").render()}" encoding="off" />
                    <isprint value="${pdict.regions.column2.setClassName(" region col-12 col-sm-4 px-0").render()}" encoding="off" />
                    <isprint value="${pdict.regions.column3.setClassName(" region col-12 col-sm-4 px-0").render()}" encoding="off" /> 
                <iselse/>
                    <isprint value="${pdict.regions.column1.setClassName(" region col-12 col-sm-4").render()}" encoding="off" />
                    <isprint value="${pdict.regions.column2.setClassName(" region col-12 col-sm-4").render()}" encoding="off" />
                    <isprint value="${pdict.regions.column3.setClassName(" region col-12 col-sm-4").render()}" encoding="off" /> 
                </isif>
            </div>
        </div>
    </div>
</div>