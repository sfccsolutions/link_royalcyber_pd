<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addCss('/css/experience/components/pd_layouts/pdPlusDesignBox.css');
</isscript>

<div class="pdplus-component pdPlusDesignBox ${pdict.bgImageParallax} ${pdict.customCss}" <isif condition="${pdict.BGImageProperties}"><isprint value="${pdict.BGImageProperties}" encoding="off" /></isif>>
    <div class="bgcolor-overlay" style= "background-color:${pdict.bgOverlay}"></div>
    <div class="pdPlusDesignBoxWrapper">

        <div class="${pdict.isContainer}">
            <iscomment> Region Created for media and content </iscomment>
            <div class="text-heading text-center">
                <h1 <isprint value="${pdict.headingTextProps}" encoding="off" />><isprint value="${pdict.headingText}" encoding="off"/></h1>
            </div>
            <isprint value="${pdict.regions.pdPlusDesignBox.setClassName('pdPlusDesignBox-wrapper').render()}" encoding="off" />
        </div>
    </div>
</div>
