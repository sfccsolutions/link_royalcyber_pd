<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addCss('/css/experience/components/pd_layouts/pdPlusSlideWithImage.css');
    assets.addCss('/css/experience/components/pd_assets/pdplusThemeTypo.css');
</isscript>

<div class="pdplus-component ${pdict.bgImageParallax} ${pdict.customCss}">
    <div class="pdplus-slideWithImage" <isif condition="${pdict.BGImageProperties}"><isprint value="${pdict.BGImageProperties}" encoding="off" /></isif>>
        <div class="bgcolor-overlay" style= "background-color:${pdict.bgOverlay}"></div>

        <div class="slide-content-holder">
            <div class="${pdict.isContainer} ${pdict.customizeSpaces}">
                <div class="text-image-container ${pdict.textXaxisAlignment}">
                    <div class="slide-content-wrapper inner-content d-flex align-items-${pdict.textAlignmentVertical}">
                        <isif condition="${pdict.removeGutter === true}">
                            <isprint value="${pdict.regions.pdPlusColumn1.setClassName("region text-column").render()}" encoding="off" />
                            <isprint value="${pdict.regions.pdPlusColumn2.setClassName("region photo-column").render()}" encoding="off" /> 
                        <iselse/>
                            <isprint value="${pdict.regions.pdPlusColumn1.setClassName("region text-column").render()}" encoding="off" />
                            <isprint value="${pdict.regions.pdPlusColumn2.setClassName("region photo-column").render()}" encoding="off" /> 
                        </isif>        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
