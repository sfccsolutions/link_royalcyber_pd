<iscontent type="text/html" charset="UTF-8" compact="true"/>
<isdecorate template="common/layout/page">
	<isscript>
	    var assets = require('*/cartridge/scripts/assets.js');
		assets.addCss('/css/experience/cms.css');
		assets.addJs('/js/cms.js');
	</isscript>

	<!--- the page markup --->
	<div class="page-designer-reference">
	    <div id="${pdict.page.ID}" class="page-designer-cms pdplus-cms">
	        <isprint value="${pdict.regions.main.setClassName("cms-page-wrapper").render()}" encoding="off"/>
	    </div>
	</div>
</isdecorate>