{
  "name": "PD Plus Text With Image",
  "description": "Select a photo that you want to insert into your layout component",
  "group": "pd_assets",
  "attribute_definition_groups": [
        {
          "id": "textImageComponent",
          "name": "Custom Tile Configurations",
          "description": "This component will display image with subtitle positions.",
          "attribute_definitions": [
                {
                    "id": "isContainer",
                    "name": "Enable Layout Fluid",
                    "description": "Enable Layout Fluid OR Layout Fixed.",
                    "type": "boolean",
                    "required": false
                }, 
                {
                    "id": "textXaxisAlignment",
                    "name": "Text Position along x-axis w.r.t Image",
                    "description": "Text Position of Container w.r.t Image",
                    "type": "enum",
                    "values": [
                        "text on left",
                        "text on right"
                    ],
                    "default_value": "text on left",
                    "required": true
                },
                {
                    "id": "textAlignmentVertical",
                    "name": "Position of text container along y-axis",
                    "description": "Position of text container along vertical direction",
                    "type": "enum",
                    "values": [
                        "top",
                        "center",
                        "bottom"
                    ],
                    "default_value": "center",
                    "required": false
                },
                {
                    "id": "textAlignmentHorizontal",
                    "name": "Position of text container along x-axis",
                    "description": "Position of text container along Horizontal direction",
                    "type": "enum",
                    "values": [
                        "left",
                        "center",
                        "right"
                    ],
                    "default_value": "left",
                    "required": false
                },
                {
                    "id": "imgFile",
                    "name": "Tile Image",
                    "description": "Choose Image",
                    "type": "image",
                    "required": true
                },
                {
                    "id": "imgScaleHover",
                    "name": "Enable Scale Image on Hover",
                    "description": "Enable scaling Image on Hover",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "imgAlt",
                    "name": "Alternate Text of Image",
                    "description": "Alternative Text",
                    "type": "string",
                    "required": true
                },
                {
                    "id": "richText",
                    "name": "Rich Text Editor",
                    "description": "Rich Text Content Area",
                    "type": "markup",
                    "required": true
                },
                {
                    "id": "buttonText",
                    "name": "Button of Text Editor",
                    "description": "Button of Rich Text Editor",
                    "type": "string",
                    "required": false
                },
                {
                    "id": "buttonAlignmentHorizontal",
                    "name": "Position of button container along x-axis",
                    "description": "Position of text container along Horizontal direction",
                    "type": "enum",
                    "values": [
                        "left",
                        "center",
                        "right"
                    ],
                    "default_value": "left",
                    "required": false
                },
                {
                    "id": "tileLink",
                    "name": "Link on Anchor Button",
                    "description": "Provide the Link URL of Anchor Button.",
                    "type": "url",
                    "required": false
                },
                {
                    "id": "tileNewtab",
                    "name": "New Tab",
                    "description": "Open Link in New Tab",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "backgroundColor",
                    "name": "Specify Background Color of Text Container",
                    "description": "Set Background Color",
                    "required": false,
                    "type": "custom",
                    "editor_definition": {
                        "type": "themer.colorpicker"
                    }
                }
            ]
        }
    ],
  "region_definitions": []
}
