{
    "name": "Pd Plus Content Box Editor",
    "description": "This is the Textbox Component, can be used as Help or FAQ pages",
    "group": "pd_assets",
    "attribute_definition_groups": [{
        "id": "textContent",
        "name": "Text Content",
        "description": "The content to show in this component",
        "attribute_definitions": [
            {
                "id": "animationType",
                "name": "Animation Type e.g (fade-in, fade-up, fade-down)",
                "description": "Please select type of animation",
                "type": "string",
                "required": false
            },
            {
                "id": "animationDuration",
                "name": "Animation Duration e.g (1000 is equal 1s)",
                "description": "Please select duration of animation",
                "type": "string",
                "required": false
            },
            {
                "id": "headingText",
                "name": "Top Heading text",
                "description": "This is the heading text",
                "type": "string",
                "required": false
            },
            {
                "id": "contentBlockTxtColor",
                "name": "Specify content block text color",
                "description": "Set content text color",
                "required": false,
                "type": "custom",
                "editor_definition": {
                    "type": "themer.colorpicker"
                }
            },
            {
                "id": "richText",
                "name": "Rich text content area",
                "description": "This is the rich text content area",
                "type": "markup",
                "required": false
            },
            {
                "id": "maxWidthText",
                "name": "Max Width of Content Section in (px)",
                "description": "Please add max width of content section",
                "type": "string",
                "required": false
            },
            {
                "id": "textShadow",
                "name": "Please select the text shadow type",
                "description": "Shadow type e.g (Parallax/Fixed)",
                "type": "enum",
                "values": [
                    "Text White Shadow",
                    "Text Black Shadow"
                ],
                "required": false
            },
            {
                "id": "customShadowHeading",
                "name": "Custom shadow for heading (2px 2px 2px #ColorName)",
                "description": "Custom shadow w.r.t content text block",
                "type": "string",
                "required": false
            },
            {
                "id": "customShadowParagraph",
                "name": "Custom shadow for paragraph (1px 1px 1px #ColorName)",
                "description": "Custom shadow w.r.t content text block",
                "type": "string",
                "required": false
            },
            {
                "id": "buttonText",
                "name": "Button for Text Editor",
                "description": "This is the button for text content area",
                "type": "string",
                "required": false
            },
            {
                "id": "tileLink",
                "name": "Link on Anchor Button",
                "description": "Provide the Link URL of Anchor Button.",
                "type": "url",
                "required": false
            },
            {
                "id": "tileNewtab",
                "name": "New Tab",
                "description": "Open Link in New Tab",
                "type": "boolean",
                "required": false
            },
            {
                "id": "buttonBgColor",
                "name": "Specify button background color",
                "description": "Set button background color",
                "required": false,
                "type": "custom",
                "editor_definition": {
                    "type": "themer.colorpicker"
                }
            },
            {
                "id": "buttonTextColor",
                "name": "Specify button text color",
                "description": "Set button text color",
                "required": false,
                "type": "custom",
                "editor_definition": {
                    "type": "themer.colorpicker"
                }
            },
            {
                "id": "buttonBorderColor",
                "name": "Specify button border color",
                "description": "Set button border color",
                "required": false,
                "type": "custom",
                "editor_definition": {
                    "type": "themer.colorpicker"
                }
            }
        ]
    }],
    "region_definitions": []
}