{
    "name": "PD Plus Featured Banner Layout",
    "group": "pd_layouts",
    "attribute_definition_groups": [
        {
            "id": "componentSettings",
            "name": "Component Settings",
            "description": "The visual display of the Featured Banner Container.",
            "attribute_definitions": [
                {
                    "id": "brandText",
                    "name": "Brand Text",
                    "description": "Enter the Brand Text.",
                    "type": "string",
                    "required": false
                },
                {
                    "id": "assetSrc",
                    "name": "Choose background image or video",
                    "description": "Select video of video to be placed in the featured banner",
                    "type": "enum",
                    "values": [
                        "image",
                        "video"
                    ],
                    "default_value": "image",
                    "required": true
                },
                {
                    "id": "bgImage",
                    "name": "Choose Featured Banner",
                    "description": "Select Featured Banner",
                    "type": "image",
                    "required": false
                },
                {
                    "id": "bgVideo",
                    "name": "Choose youtube Video URL on featured banner",
                    "description": "Select video url",
                    "type": "url",
                    "required": false
                },
                {
                    "id": "isContentSticky",
                    "name": "Is Content Sticky",
                    "description": "Choose Content Sticky",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "productTitle",
                    "name": "Banner Title",
                    "type": "string",
                    "required": false
                },
                {
                    "id": "productSubTitle",
                    "name": "Banner Sub Title",
                    "type": "string",
                    "required": false
                },
                {
                    "id": "productDescription",
                    "name": "Product Description",
                    "type": "string",
                    "required": false
                },
                {
                    "id": "productLink",
                    "name": "Banner Product Link",
                    "type": "url",
                    "required": false
                },
                {
                    "id": "productLinkNewTab",
                    "name": "Open in New Tab",
                    "type": "boolean",
                    "required": false
                },
                {
                    "id": "bannerContentPosition",
                    "name": "Position of Banner Content",
                    "type": "enum",
                    "default_value": "center left",
                    "values": [
                        "left top",
                        "center top",
                        "right top",
                        "center left",
                        "center",
                        "center right",
                        "bottom left",
                        "bottom center",
                        "bottom right"
                    ],
                    "required": false
                },
                {
                    "id": "styleBlock",
                    "name": "Style Block",
                    "type": "text",
                    "required": false
                },
                {
                    "id": "hotspotContentXPos",
                    "name": "Position of Hotspot Content along X-axis",
                    "type": "enum",
                    "default_value": "right",
                    "values": [
                        "left",
                        "center",
                        "right"
                    ],
                    "required": false
                },
                {
                    "id": "hotspotContentYPos",
                    "name": "Position of Hotspot Content along Y-axis",
                    "type": "enum",
                    "default_value": "bottom",
                    "values": [
                        "top",
                        "center",
                        "bottom"
                    ],
                    "required": false
                },
                {
                    "id": "noOfTiles",
                    "name": "Number of tiles",
                    "description": "Add no. of Product Tiles",
                    "type": "enum",
                    "values": [
                        1,
                        2,
                        3
                    ],
                    "required": false
                }
            ]
        }
    ],
