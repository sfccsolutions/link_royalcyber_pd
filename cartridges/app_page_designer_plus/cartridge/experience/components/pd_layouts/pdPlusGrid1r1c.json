                    "required": false
                },
                {
                    "id": "maxWidth",
                    "name": "Add max-width of container",
                    "description": "Please maximum width of container",
                    "type": "string",
                    "required": false
                },
                {
                    "id": "verticalAlignment",
                    "name": "Position of container along y-axis",
                    "description": "Position of text container along vertical direction",
                    "type": "enum",
                    "values": [
                        "top",
                        "center",
                        "bottom"
                    ],
                    "default_value": "center",
                    "required": false
                },
                {
                    "id": "horizontalAlginment",
                    "name": "Position of container along x-axis",
                    "description": "Position of text container along horizontal direction",
                    "type": "enum",
                    "values": [
                        "left",
                        "center",
                        "right"
                    ],
                    "default_value": "center",
                    "required": false
                },
                {
                    "id": "bgImageParallax",
                    "name": "Please select the background type ",
                    "description": "Background type e.g (Parallax/Fixed)",
                    "type": "enum",
                    "values": [
                        "Parallax",
                        "Normal"
                    ],
                    "required": false
                },
                {
                    "id": "sectionHeight",
                    "name": "Section Height i.e. 20px / 1.25rem",
                    "description": "Provide height value applied section Height",
                    "type": "string",
                    "required": false
                },
                {
                    "id": "bgOverlay",
                    "name": "Background Image Overlay Color in (RGBA)",
                    "description": "Provide overlay color of background",
                    "type": "string",
                    "required": false
                },
                {
                    "id": "bgGradiant",
                    "name": "Background Gradiant Color",
                    "description": "Provide gradiant color of background",
                    "type": "string",
                    "required": false
                },
                {
                    "id": "backgroundColor",
                    "name": "Specify Background Color",
                    "description": "Set Background Color",
                    "required": false,
                    "type": "custom",
                    "editor_definition": {
                        "type": "themer.colorpicker"
                    }
                },
                {
                    "id": "backgroundColorAlpha",
                    "name": "Specify Background Color transparency between 10 and 100",
